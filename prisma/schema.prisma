// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  createdAt DateTime @default(now())
  
  // Organizations owned by this user
  ownedOrganizations Organization[]
  
  // Themes created by this user
  themes             Theme[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  
  // Relation to the owner
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Themes associated with this organization
  themes    Theme[]
}

model Theme {
  id             String       @id @default(cuid())
  name           String       @default("Default Theme")
  tokens         Json         // JSON object containing all design tokens (colors, typography, spacing, etc.)
  organizationId String?      // Optional: Associate with organization (nullable for personal themes)
  userId         String       // The user who created/owns this theme
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}
